---
export interface Props {
  title: string;
  price: string;
  description?: string;
}
const { title, price, description } = Astro.props as Props;
---
<div class="bg-card rounded shadow p-4 reveal">
  <h3 class="font-semibold text-lg" style="font-family: Inter, sans-serif;">{title}</h3>
  <p class="text-sm text-[var(--muted-text)] mt-1">{description ?? ''}</p>
  <div class="mt-3 text-[var(--primary)] font-semibold">{price}</div>
</div>