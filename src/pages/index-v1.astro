---
import { Inter } from 'astro:fonts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import '../styles/global.css';
 
const inter = Inter({ subsets: ['latin'], weight: ['400', '700'] });

const CLIENT = {
  name: 'Dental Sonrisa Norte',
  whatsapp: '525512348765',
  services: [
    { title: 'Limpieza dental', price: '$350' },
    { title: 'Extracción simple', price: '$400' },
    { title: 'Resina dental', price: '$600' },
    { title: 'Blanqueamiento LED', price: '$1,200' },
    { title: 'Ortodoncia', price: 'desde $8,000' },
    { title: 'Implante dental', price: 'desde $12,000' },
  ],
  location: 'Lindavista, Gustavo A. Madero, CDMX',
  reference: '2 cuadras del Metro Deportivo 18 de Marzo',
  hours: 'Lunes a viernes 9am-7pm · Sábados 9am-2pm',
  experience: '12 años · ~1,800 pacientes atendidos',
  reviews: { rating: '4.7', count: 143 },
  testimonials: [
    { text: 'El Dr. fue muy amable y no sentí nada', author: 'Carmen R.' },
    { text: 'Precios justos y atención rápida', author: 'Jorge M.' },
    { text: 'Por fin un dentista sin miedo', author: 'Patricia L.' }
  ],
  instagram: '@dentalsoniranorte',
  differentiator: 'Primera consulta y diagnóstico sin costo · Atención sin dolor garantizada · Sábados disponibles',
  image: '/images/clinic-hero1.webp',
};
---
<!doctype html>
<html lang="es-MX" class={inter.className}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dental Sonrisa Norte | Dentista en Lindavista</title>
    <meta name="description" content="Dentista en Lindavista, CDMX. Primera consulta sin costo. Atención sin dolor garantizada." />
  </head>
  <body class="bg-[oklch(98% 0 0deg)] text-[var(--text)]">
    <Header/>

    <!-- HERO -->
    <section class="max-w-5xl mx-auto px-4 py-6 md:py-12 reveal">
      <div class="flex flex-col md:flex-row items-center gap-6">
        <div class="md:w-1/2">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold" style="background: oklch(60% 18 315deg); color:white;">Primera consulta sin costo</span>
          <h1 class="mt-3 text-3xl md:text-5xl font-extrabold" style="font-family: Inter, sans-serif;">Sin miedo, <br/>sin dolor. Tu sonrisa empieza aquí.</h1>
          <p class="mt-4 text-sm md:text-base text-[var(--muted-text)]">En Lindavista, Dental Sonrisa Norte cuida tu salud bucal con experiencia de 12 años y atención sin dolor garantizada.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="#servicios" class="btn-whatsapp pulse hidden md:inline-block">Agenda tu cita</a>
            <WhatsAppButton phone={CLIENT.whatsapp} text="Quiero agendar" utm="utm_source=landing&utm_medium=web&utm_campaign=dental_sonrisanorte" />
          </div>
        </div>
        <div class="md:w-1/2 min-h-[260px] w-full rounded shadow overflow-hidden bg-white" aria-label="Imagen de clínica">
          <img src="/images/clinic-hero1.webp" alt="Clínica dental" style="width:100%; height:100%; object-fit:cover;"/>
        </div>
      </div>
    </section>

    <!-- Servicios -->
    <section id="servicios" class="max-w-5xl mx-auto px-4 py-6 reveal">
      <h2 class="text-2xl font-bold mb-4" style="font-family: Inter, sans-serif;">Servicios</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {CLIENT.services.map((s) => (
          <ServiceCard title={s.title} price={s.price} />
        ))}
      </div>
    </section>

    <!-- Reseñas -->
    <section id="testimonios" class="max-w-5xl mx-auto px-4 py-6 reveal">
      <h2 class="text-2xl font-bold mb-3" style="font-family: Inter, sans-serif;">Reseñas</h2>
      <div class="flex flex-col md:flex-row gap-4">
        {CLIENT.testimonials.map((t, idx) => (
          <blockquote class="p-4 border rounded shadow-sm" aria-label={`testimonio-${idx}`}>
            <p class="text-[var(--text)]">"{t.text}"</p>
            <footer class="mt-2 text-sm text-[var(--muted-text)]">— {t.author}</footer>
          </blockquote>
        ))}
      </div>
      <div class="mt-4 text-sm text-[var(--muted-text)]">Reseñas Google: {CLIENT.reviews.rating}★ con {CLIENT.reviews.count} reseñas</div>
    </section>

    <!-- Sobre nosotros -->
    <section id="nosotros" class="max-w-5xl mx-auto px-4 py-6 reveal">
      <h2 class="text-2xl font-bold mb-3" style="font-family: Inter, sans-serif;">Sobre nosotros</h2>
      <p class="text-sm text-[var(--muted-text)]">{CLIENT.differentiator}</p>
    </section>

    <!-- Aviso de Privacidad -->
    <section id="aviso" class="max-w-5xl mx-auto px-4 py-6 reveal">
      <h2 class="text-2xl font-bold mb-3" style="font-family: Inter, sans-serif;">Aviso de Privacidad</h2>
      <p class="text-sm text-[var(--muted-text)]">Este portal protege tus datos personales conforme a la LFPDPPP.</p>
      <a href="/aviso-de-privacidad" class="mt-2 inline-block text-sm underline">Ver aviso de privacidad completo</a>
    </section>

    <!-- Contacto flotante de WhatsApp -->
    <div class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-50" aria-label="CTA de WhatsApp">
      <WhatsAppButton phone={CLIENT.whatsapp} utm="utm_source=landing&utm_medium=web&utm_campaign=dental_sonrisanorte" text="Quiero agendar cita" />
    </div>

    <Footer/>
  </body>
  
</html>